{
  "starts_at": "open_page",
  "states": {
    "open_page": {
      "type": "open_page",
      "input": {
        "url": "{{=it.url}}",
        "timeout": 30000,
        "wait_until": "domcontentloaded"
      },
      "next": "wait_for_continue_button"
    },
    "wait_for_continue_button": {
      "type": "wait_for_selector",
      "input": {
        "selector": "#btnAccept",
        "timeout": 15000,
        "visible": true
      },
      "next": "click_continue_button"
    },
    "click_continue_button": {
      "type": "click",
      "input": {
        "selector": "#btnAccept"
      },
      "next": "wait_for_vid_button"
    },
    "wait_for_vid_button": {
      "type": "wait_for_selector",
      "input": {
        "selector": "#tab-VID",
        "timeout": 15000,
        "visible": true
      },
      "next": "click_vid_button"
    },
    "click_vid_button": {
      "type": "click",
      "input": {
        "selector": "#tab-VID"
      },
      "next": "wait_for_search_form"
    },
    "wait_for_search_form": {
      "type": "wait_for_selector",
      "input": {
        "selector": "#parcel_vid",
        "timeout": 30000,
        "visible": true
      },
      "next": "enter_vid"
    },
    "enter_vid": {
      "type": "type",
      "input": {
        "selector": "#parcel_vid",
        "value": "{{=it.request_identifier}}",
        "clear": true,
        "delay": 100
      },
      "next": "submit_search"
    },
    "submit_search": {
      "type": "click",
      "input": {
        "selector": "#btnSearch"
      },
      "next": "wait_for_Value"
    },
    "wait_for_Value": {
      "type": "wait_for_selector",
      "input": {
        "selector": "#tab-Value",
        "timeout": 30000,
        "visible": true
      },
      "next": "click_Value"
    },
    "click_Value": {
      "type": "click",
      "input": {
        "selector": "#tab-Value"
      },
      "next": "wait_for_ValueLoad"
    },
    "wait_for_ValueLoad": {
      "type": "wait_for_selector",
      "input": {
        "selector": "#details-Value > div:nth-child(1) > div.card-body.details-card-body.p-2 > div > div > div > table",
        "timeout": 5000,
        "visible": true
      },
      "continue_on_timeout": true,
      "next": "wait_for_Land",
      "next_on_timeout": "wait_for_Value_2"
    },
    "wait_for_Value_2": {
      "type": "wait_for_selector",
